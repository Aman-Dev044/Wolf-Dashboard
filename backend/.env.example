# MongoDB Atlas connection (database: wolf)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.ymhibnf.mongodb.net/wolf?retryWrites=true&w=majority&appName=Cluster0

# Comma separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:3001

# Change this to a long random string in production
JWT_SECRET=replace-with-a-long-random-string

# Admin account created by `npm run seed`
ADMIN_EMAIL=admin@wolfstores.com.au
ADMIN_PASSWORD=replace-me

# Order pricing (AUD). Delivery fee is waived at or above the threshold.
DELIVERY_FEE=0
FREE_DELIVERY_THRESHOLD=0
